# Streamlit Community Cloud: paste these into the app's Settings > Secrets. Never commit real values.
GROQ_API_KEY = ""
GEMINI_API_KEY = ""
# Shared passcode shown before the app opens. Strongly recommended for any URL other people can reach.
APP_PASSCODE = ""
# Locks ONLY the live LLM option (offline auditing stays open to everyone). Use this on a public demo so visitors
# cannot spend your free-tier quota. An empty value means unlocked, so leave the line out unless you set a real passcode.
# LIVE_LLM_PASSCODE = "choose-something-long"
# LLM_PROVIDERS = "groq,gemini"
