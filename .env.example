# Copy this file to .env (git-ignored) and fill in a key; run_pipeline.py loads it automatically. Set at least ONE; more = automatic failover.
# Free keys: Gemini -> https://aistudio.google.com/apikey | Groq -> https://console.groq.com/keys | OpenRouter -> https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional
# LLM_PROVIDERS=gemini,groq,openrouter      # priority order
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_MIN_INTERVAL_SECONDS=4                # throttle between calls to stay inside free-tier rate limits
